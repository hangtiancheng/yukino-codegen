# Runtime environment. Use `development`, `test`, or `production`.
NODE_ENV=development

# HTTP port used by the Hono server.
PORT=3000

# Public API prefix mounted by the server, for example `/api`.
BASE_URL=api

# Application log level. Supported values: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://root:pass@localhost:5432/yukino_codegen

# Redis connection string used for sessions, queues, and rate limiting.
REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum accepted HTTP request body size in bytes.
REQUEST_BODY_LIMIT_BYTES=1048576

# Maximum user prompt length accepted by AI generation endpoints.
PROMPT_MAX_LENGTH=4096

# Salt used for password hashing. Override this with a private random value.
PASSWORD_SALT=yukino_codegen

# Secret used to sign sessions. Use at least 32 bytes of random data.
SESSION_SECRET=yukino_codegen123456

# Enables the model health probe in the health-check endpoint.
MODEL_PROVIDER_HEALTH_CHECK_ENABLED=true

# Maximum time in milliseconds allowed for the model health probe.
MODEL_PROVIDER_HEALTH_CHECK_TIMEOUT_MS=5000

# Maximum number of AI generation requests allowed per rate-limit window.
LLM_RATE_LIMIT=10

# Rate-limit window length in seconds for AI generation requests.
LLM_RATE_LIMIT_WINDOW_SECONDS=60

# Wire protocol used to talk to the model. Supported values: anthropic, openai, openai-compat.
AI_PROTOCOL=openai-compat

# Base URL of the model endpoint. The openai-compat protocol requires the /v1 suffix.
AI_BASE_URL=https://api.deepseek.com

# Model used by the code generation agent.
AI_MODEL=deepseek-flash

# API key sent to the model endpoint. Local servers such as Ollama ignore the value.
AI_API_KEY=sk-local

# Maximum output tokens per model response. Leave unset to derive it from the model.
AI_MAX_OUTPUT_TOKENS=65536

# Context window size in tokens. Leave unset to derive it from the model.
# AI_CONTEXT_WINDOW=

# Maximum number of agent tool-use iterations per generation request.
AI_MAX_ITERATIONS=40

# Storage backend for generated assets. Supported values: local, minio.
STORAGE_DRIVER=local

# Local filesystem directory used when STORAGE_DRIVER is `local`.
STORAGE_LOCAL_ROOT_DIR=tmp/storage

# Public base URL for files served from local storage.
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8123/storage

# MinIO endpoint host used when STORAGE_DRIVER is `minio`.
STORAGE_MINIO_ENDPOINT=localhost

# MinIO endpoint port.
STORAGE_MINIO_PORT=9000

# Whether to connect to MinIO over HTTPS.
STORAGE_MINIO_USE_SSL=false

# MinIO access key used when STORAGE_DRIVER is `minio`.
STORAGE_MINIO_ACCESS_KEY=<minio_access_key>

# MinIO secret key used when STORAGE_DRIVER is `minio`.
STORAGE_MINIO_SECRET_KEY=<minio_secret_key>

# MinIO bucket used to store generated assets.
STORAGE_MINIO_BUCKET=yukino-codegen

# Public base URL for files served from the MinIO bucket.
STORAGE_MINIO_PUBLIC_BASE_URL=http://localhost:9000/yukino-codegen
