{
  "name": "server",
  "version": "0.0.0",
  "description": "Hono backend for AI code generation.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "build": "pnpm prisma:generate && rollup -c ./rollup.config.js",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "typecheck": "tsc -b --noEmit",
    "check": "biome check --write .",
    "check:ci": "biome check --reporter=github .",
    "ci": "pnpm prisma:validate && pnpm build && pnpm check:ci",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@yukino.js/yukino": "latest",
    "archiver": "^7.0.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "prisma": "^7.10.0",
    "rollup": "^4.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "private": true
}
